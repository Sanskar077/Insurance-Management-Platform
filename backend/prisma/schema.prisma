generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  RENEWED
}

enum PolicyType {
  LIFE
  HEALTH
  VEHICLE
  HOME
  TRAVEL
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

enum ClaimType {
  LIFE
  HEALTH
  VEHICLE
  HOME
  TRAVEL
  OTHER
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Authentication & authorization. Every login (Admin, Agent, or Customer)
/// is a User. A CUSTOMER-role User has exactly one linked Customer profile.
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?

  @@index([role])
  @@map("users")
}

/// Business profile of a customer. Created alongside the User record when a
/// CUSTOMER registers. One-to-one with User.
model Customer {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  dob       DateTime
  phone     String
  address   String
  email     String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  policies  Policy[]
  documents Document[]

  @@index([deletedAt])
  @@map("customers")
}

model Policy {
  id             String       @id @default(uuid())
  customerId     String
  policyNumber   String       @unique
  policyType     PolicyType
  premiumAmount  Decimal      @db.Decimal(12, 2)
  coverageAmount Decimal      @db.Decimal(12, 2)
  startDate      DateTime
  endDate        DateTime
  status         PolicyStatus @default(ACTIVE)
  description    String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  claims          Claim[]
  premiumPayments PremiumPayment[]

  /// Renewal lineage: when a policy is renewed, a *new* Policy row is created
  /// for the new period and the old row's status becomes RENEWED — it is
  /// never mutated or deleted, preserving its original dates as history.
  renewedFromId String?
  renewedFrom   Policy?  @relation("PolicyRenewal", fields: [renewedFromId], references: [id])
  renewedTo     Policy[] @relation("PolicyRenewal")

  @@index([customerId])
  @@index([status])
  @@index([policyType])
  @@index([deletedAt])
  @@index([endDate])
  @@map("policies")
}

/// A claim can never exist without a policy — policyId is required, and the
/// policy relation uses onDelete: Restrict so a policy with claims cannot be
/// deleted out from under them.
model Claim {
  id             String      @id @default(uuid())
  policyId       String
  claimNumber    String      @unique
  claimType      ClaimType
  claimAmount    Decimal     @db.Decimal(12, 2)
  approvedAmount Decimal?    @db.Decimal(12, 2)
  incidentDate   DateTime
  claimDate      DateTime    @default(now())
  description    String
  status         ClaimStatus @default(SUBMITTED)
  remarks        String?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId])
  @@index([status])
  @@index([claimType])
  @@index([deletedAt])
  @@map("claims")
}

model PremiumPayment {
  id                    String        @id @default(uuid())
  policyId              String
  amount                Decimal       @db.Decimal(12, 2)
  dueDate               DateTime
  paymentDate           DateTime?
  paymentMethod         String?
  transactionReference  String?       @unique
  paymentStatus         PaymentStatus @default(PENDING)
  remarks               String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId])
  @@index([paymentStatus])
  @@index([dueDate])
  @@map("premium_payments")
}

model Document {
  id         String   @id @default(uuid())
  customerId String
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("documents")
}
