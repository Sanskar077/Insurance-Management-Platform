generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Authentication & authorization. Every login (Admin, Agent, or Customer)
/// is a User. A CUSTOMER-role User has exactly one linked Customer profile.
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?

  @@index([role])
  @@map("users")
}

/// Business profile of a customer. Created alongside the User record when a
/// CUSTOMER registers. One-to-one with User.
model Customer {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  dob       DateTime
  phone     String
  address   String
  email     String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  policies  Policy[]
  documents Document[]

  @@index([deletedAt])
  @@map("customers")
}

model Policy {
  id            String   @id @default(uuid())
  customerId    String
  policyNumber  String   @unique
  policyType    String
  premiumAmount Decimal  @db.Decimal(12, 2)
  startDate     DateTime
  endDate       DateTime
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  claims          Claim[]
  premiumPayments PremiumPayment[]

  @@index([customerId])
  @@index([status])
  @@map("policies")
}

/// A claim can never exist without a policy — policyId is required, and the
/// policy relation uses onDelete: Restrict so a policy with claims cannot be
/// deleted out from under them.
model Claim {
  id             String   @id @default(uuid())
  policyId       String
  claimAmount    Decimal  @db.Decimal(12, 2)
  reason         String
  status         String
  submissionDate DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId])
  @@index([status])
  @@map("claims")
}

model PremiumPayment {
  id            String   @id @default(uuid())
  policyId      String
  paymentDate   DateTime
  amount        Decimal  @db.Decimal(12, 2)
  paymentStatus String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId])
  @@index([paymentStatus])
  @@map("premium_payments")
}

model Document {
  id         String   @id @default(uuid())
  customerId String
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("documents")
}
